class AdminHandler(SimpleHTTPRequestHandler):

    def __init__(self, *args, **kwargs):
        super().__init__(directory=str(ROOT), **kwargs)

    def _json_response(self, status, payload):
        body = json.dumps(payload).encode("utf-8")

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )
        self.send_header(
            "Content-Length",
            str(len(body))
        )
        self.end_headers()

        self.wfile.write(body)

    def _read_json(self):
        try:
            length = int(
                self.headers.get(
                    "Content-Length",
                    "0"
                )
            )

            if length <= 0:
                return None

            body = self.rfile.read(length)

            return json.loads(
                body.decode("utf-8")
            )

        except Exception:
            return None

    def do_POST(self):

        if (
            self.path.split("?", 1)[0]
            != "/api/servers"
        ):
            self.send_error(404)
            return

        payload = self._read_json()

        if not isinstance(payload, dict):
            self._json_response(
                400,
                {
                    "ok": False,
                    "error": "Invalid JSON request."
                }
            )
            return

        action = payload.get("action")

        try:

            servers = load_json(
                "servers.json"
            )

            if not isinstance(servers, list):
                raise ValueError(
                    "servers.json must contain an array."
                )

            if action == "create":

                server = payload.get(
                    "server"
                )

                if not isinstance(server, dict):
                    raise ValueError(
                        "Missing server data."
                    )

                server_id = str(
                    server.get("id", "")
                ).strip()

                if not server_id:
                    raise ValueError(
                        "Server ID is required."
                    )

                if any(
                    str(item.get("id", "")) ==
                    server_id
                    for item in servers
                ):
                    raise ValueError(
                        "A server with that ID already exists."
                    )

                servers.append(server)

                save_json(
                    "servers.json",
                    servers
                )

                asset_dir = (
                    ASSETS /
                    "servers" /
                    server_id /
                    "screenshots"
                )

                asset_dir.mkdir(
                    parents=True,
                    exist_ok=True
                )

                self._json_response(
                    200,
                    {
                        "ok": True,
                        "server": server
                    }
                )
                return

            if action == "update":

                original_id = str(
                    payload.get(
                        "originalId",
                        ""
                    )
                ).strip()

                server = payload.get(
                    "server"
                )

                if not original_id:
                    raise ValueError(
                        "Original server ID is required."
                    )

                if not isinstance(server, dict):
                    raise ValueError(
                        "Missing server data."
                    )

                new_id = str(
                    server.get("id", "")
                ).strip()

                if not new_id:
                    raise ValueError(
                        "Server ID is required."
                    )

                index = next(
                    (
                        i
                        for i, item
                        in enumerate(servers)
                        if str(
                            item.get("id", "")
                        ) == original_id
                    ),
                    None
                )

                if index is None:
                    raise ValueError(
                        "Server not found."
                    )

                if any(
                    i != index and
                    str(item.get("id", "")) ==
                    new_id
                    for i, item
                    in enumerate(servers)
                ):
                    raise ValueError(
                        "A server with that ID already exists."
                    )

                servers[index] = server

                save_json(
                    "servers.json",
                    servers
                )

                asset_dir = (
                    ASSETS /
                    "servers" /
                    new_id /
                    "screenshots"
                )

                asset_dir.mkdir(
                    parents=True,
                    exist_ok=True
                )

                self._json_response(
                    200,
                    {
                        "ok": True,
                        "server": server
                    }
                )
                return

            if action == "delete":

                server_id = str(
                    payload.get(
                        "id",
                        ""
                    )
                ).strip()

                if not server_id:
                    raise ValueError(
                        "Server ID is required."
                    )

                original_count = len(
                    servers
                )

                servers = [
                    item
                    for item in servers
                    if str(
                        item.get("id", "")
                    ) != server_id
                ]

                if len(servers) == original_count:
                    raise ValueError(
                        "Server not found."
                    )

                save_json(
                    "servers.json",
                    servers
                )

                self._json_response(
                    200,
                    {
                        "ok": True
                    }
                )
                return

            raise ValueError(
                "Unknown action."
            )

        except Exception as error:

            self._json_response(
                400,
                {
                    "ok": False,
                    "error": str(error)
                }
            )



