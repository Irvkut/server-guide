<script>

let servers = [];
let editingId = null;


async function loadServers() {

    const container =
        document.getElementById("servers");

    const raw =
        document.getElementById("raw");

    try {

        const response =
            await fetch(
                "/config/servers.json?cache=" +
                Date.now()
            );

        if (!response.ok) {
            throw new Error(
                "HTTP " + response.status
            );
        }

        servers =
            await response.json();

        if (!Array.isArray(servers)) {
            throw new Error(
                "servers.json must contain an array"
            );
        }

        raw.textContent =
            JSON.stringify(
                servers,
                null,
                2
            );

        renderServers();

    } catch(error) {

        container.innerHTML =
            '<div class="empty">' +
            'Unable to load config/servers.json<br><br>' +
            escapeHtml(error.message) +
            '</div>';
    }
}


function renderServers() {

    const container =
        document.getElementById("servers");

    if (!servers.length) {

        container.innerHTML =
            '<div class="empty">' +
            'No servers configured.' +
            '</div>';

        return;
    }

    container.innerHTML =
        servers.map(server => {

            const status =
                String(
                    server.status || "unknown"
                ).toLowerCase();

            return `
                <div class="server">

                    <div>
                        <div class="server-name">
                            ${escapeHtml(
                                server.name || "Unnamed"
                            )}
                        </div>

                        <div class="server-id">
                            ${escapeHtml(
                                server.id || ""
                            )}
                        </div>
                    </div>

                    <div class="server-meta">
                        ${escapeHtml(
                            server.game || "Unknown"
                        )}
                        ·
                        ${escapeHtml(
                            server.mode || "Unknown"
                        )}
                    </div>

                    <div class="server-meta">
                        ${escapeHtml(
                            server.address ||
                            "No address"
                        )}
                    </div>

                    <div class="${escapeHtml(status)}">
                        ${escapeHtml(status)}
                    </div>

                    <div class="actions">

                        <button
                            onclick="editServer(
                                '${escapeJs(server.id || "")}'
                            )">
                            Edit
                        </button>

                        <button
                            class="danger"
                            onclick="deleteServer(
                                '${escapeJs(server.id || "")}'
                            )">
                            Delete
                        </button>

                    </div>

                </div>
            `;

        }).join("");
}


function newServer() {

    editingId = null;

    clearServerForm();

    showEditor("Add Server");
}


function editServer(id) {

    const server =
        servers.find(
            item =>
                String(item.id) === String(id)
        );

    if (!server) {
        alert("Server not found.");
        return;
    }

    editingId =
        String(server.id);

    setValue("id", server.id);
    setValue("name", server.name);
    setValue("shortName", server.shortName);
    setValue("description", server.description);
    setValue("longDescription", server.longDescription);
    setValue("game", server.game);
    setValue("mode", server.mode);
    setValue("map", server.map);
    setValue("players", server.players);
    setValue("maxPlayers", server.maxPlayers);
    setValue("address", server.address);
    setValue("status", server.status || "unknown");
    setValue("icon", server.icon);
    setValue("artwork", server.artwork);
    setValue("logo", server.logo);
    setValue("banner", server.banner);

    setValue(
        "tags",
        Array.isArray(server.tags)
            ? server.tags.join(", ")
            : ""
    );

    setValue(
        "discord",
        server.links?.discord || "#"
    );

    setValue(
        "steam",
        server.links?.steam || "#"
    );

    setValue(
        "website",
        server.links?.website || "#"
    );

    document.getElementById(
        "featured"
    ).checked =
        Boolean(server.featured);

    showEditor("Edit Server");
}


function showEditor(title) {

    const editor =
        document.getElementById(
            "server-editor"
        );

    if (!editor) {
        return;
    }

    document.getElementById(
        "editor-title"
    ).textContent = title;

    editor.classList.remove("hidden");

    editor.scrollIntoView({
        behavior: "smooth",
        block: "start"
    });
}


async function saveServer() {

    const id =
        getValue("id").trim();

    const name =
        getValue("name").trim();

    if (!id || !name) {

        alert(
            "Server ID and name are required."
        );

        return;
    }

    const server = {

        id: id,

        name: name,

        shortName:
            getValue("shortName") ||
            name.slice(0, 3).toUpperCase(),

        description:
            getValue("description"),

        longDescription:
            getValue("longDescription") ||
            getValue("description"),

        game:
            getValue("game"),

        mode:
            getValue("mode"),

        map:
            getValue("map"),

        players:
            getValue("players") || "0",

        maxPlayers:
            getValue("maxPlayers") || "64",

        address:
            getValue("address"),

        status:
            getValue("status") || "unknown",

        featured:
            document.getElementById(
                "featured"
            ).checked,

        icon:
            getValue("icon") ||
            name.slice(0, 2).toUpperCase(),

        artwork:
            getValue("artwork"),

        logo:
            getValue("logo"),

        banner:
            getValue("banner"),

        tags:
            getValue("tags")
                .split(",")
                .map(
                    value => value.trim()
                )
                .filter(Boolean),

        links: {
            discord:
                getValue("discord") || "#",

            steam:
                getValue("steam") || "#",

            website:
                getValue("website") || "#"
        }
    };

    const action =
        editingId === null
            ? "create"
            : "update";

    try {

        const response =
            await fetch(
                "/api/servers",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            action: action,
                            originalId:
                                editingId,
                            server: server
                        })
                }
            );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.ok
        ) {
            throw new Error(
                result.error ||
                "Unable to save server."
            );
        }

        alert(
            "Server saved successfully."
        );

        editingId = null;

        clearServerForm();

        document.getElementById(
            "server-editor"
        ).classList.add("hidden");

        await loadServers();

    } catch(error) {

        alert(
            "Unable to save server:\n\n" +
            error.message
        );
    }
}


async function deleteServer(id) {

    const server =
        servers.find(
            item =>
                String(item.id) === String(id)
        );

    if (!server) {
        return;
    }

    if (
        !confirm(
            "Delete '" +
            server.name +
            "'?"
        )
    ) {
        return;
    }

    try {

        const response =
            await fetch(
                "/api/servers",
                {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({
                            action: "delete",
                            id: id
                        })
                }
            );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.ok
        ) {
            throw new Error(
                result.error ||
                "Unable to delete server."
            );
        }

        await loadServers();

    } catch(error) {

        alert(
            "Unable to delete server:\n\n" +
            error.message
        );
    }
}


function clearServerForm() {

    const fields = [
        "id",
        "name",
        "shortName",
        "description",
        "longDescription",
        "game",
        "mode",
        "map",
        "players",
        "maxPlayers",
        "address",
        "icon",
        "artwork",
        "logo",
        "banner",
        "tags",
        "discord",
        "steam",
        "website"
    ];

    fields.forEach(
        field =>
            setValue(
                field,
                ""
            )
    );

    setValue("players", "0");
    setValue("maxPlayers", "64");
    setValue("status", "online");

    document.getElementById(
        "featured"
    ).checked = false;
}


function setValue(field, value) {

    const element =
        document.getElementById(
            "server-" + field
        );

    if (element) {
        element.value =
            value == null
                ? ""
                : String(value);
    }
}


function getValue(field) {

    const element =
        document.getElementById(
            "server-" + field
        );

    return element
        ? element.value
        : "";
}


function escapeHtml(value) {

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function escapeJs(value) {

    return String(value)
        .replaceAll("\\", "\\\\")
        .replaceAll("'", "\\'")
        .replaceAll("\n", "\\n")
        .replaceAll("\r", "\\r");
}


async function runValidate() {

    alert(
        "Run this in the terminal:\n\n" +
        "./admin/server-guide validate"
    );
}


loadServers();

</script>

