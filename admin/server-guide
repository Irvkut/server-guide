def remove_server():

    ensure_structure()

    servers = load_json("servers.json")

    if not servers:
        print("No servers configured.")
        return

    list_servers()

    sid = input(
        "\nServer ID to remove: "
    ).strip()

    matches = [
        s for s in servers
        if str(s.get("id")) == sid
    ]

    if not matches:
        print("Server not found.")
        return

    confirm = input(
        f"Remove '{matches[0].get('name', sid)}'? [y/N]: "
    ).strip().lower()

    if confirm != "y":
        print("Cancelled.")
        return

    servers = [
        s for s in servers
        if str(s.get("id")) != sid
    ]

    save_json(
        "servers.json",
        servers
    )

    print("✓ Server removed.")


def validate():

    ensure_structure()

    print()
    print("SERVER GUIDE VALIDATION")
    print("=" * 45)

    errors = 0
    warnings = 0

    for filename in [
        "site.json",
        "servers.json",
        "news.json",
        "community.json",
        "downloads.json",
        "rules.json",
        "theme.json"
    ]:

        path = CONFIG / filename

        if not path.exists():

            print(
                f"[ERROR] Missing config/{filename}"
            )

            errors += 1
            continue

        try:

            json.loads(
                path.read_text(
                    encoding="utf-8"
                )
            )

            print(
                f"[ OK ] config/{filename}"
            )

        except Exception as exc:

            print(
                f"[ERROR] config/{filename}: {exc}"
            )

            errors += 1

    try:

        servers = load_json(
            "servers.json"
        )

        ids = set()

        if not isinstance(
            servers,
            list
        ):

            print(
                "[ERROR] servers.json must be an array"
            )

            errors += 1

        else:

            for server in servers:

                sid = server.get("id")

                if not sid:

                    print(
                        "[ERROR] Server missing ID"
                    )

                    errors += 1
                    continue

                if sid in ids:

                    print(
                        f"[ERROR] Duplicate server ID: {sid}"
                    )

                    errors += 1

                ids.add(sid)

                if not server.get("name"):

                    print(
                        f"[WARN] {sid}: missing name"
                    )

                    warnings += 1

                if not server.get("address"):

                    print(
                        f"[WARN] {sid}: missing address"
                    )

                    warnings += 1

                print(
                    f"[ OK ] server: {sid}"
                )

    except Exception as exc:

        print(
            f"[ERROR] Unable to inspect servers: {exc}"
        )

        errors += 1

    print()
    print("=" * 45)
    print(f"Errors:   {errors}")
    print(f"Warnings: {warnings}")

    return errors == 0


