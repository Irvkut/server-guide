def list_servers():

    ensure_structure()

    servers = load_json("servers.json")

    print()
    print("SERVERS")
    print("=" * 70)

    if not servers:
        print("No servers configured.")
        return

    for index, server in enumerate(servers, 1):

        status = server.get(
            "status",
            "unknown"
        )

        featured = (
            " ★ FEATURED"
            if server.get("featured")
            else ""
        )

        print(
            f"{index}. "
            f"{server.get('name', 'Unnamed')} "
            f"[{server.get('id', '?')}] "
            f"- {status}"
            f"{featured}"
        )

        print(
            f"   {server.get('game', 'Unknown')} | "
            f"{server.get('mode', 'Unknown')} | "
            f"{server.get('address', 'No address')}"
        )


